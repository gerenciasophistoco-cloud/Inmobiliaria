# ── IA (Anthropic / Claude) ───────────────────────────────────────────────────
# Obtén tu API key en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Base de datos (Supabase) ──────────────────────────────────────────────────
# Crea un proyecto en https://supabase.com y ejecuta en el SQL Editor:
#
#   CREATE TABLE propiedades (
#     id    TEXT PRIMARY KEY,
#     datos JSONB NOT NULL,
#     created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
#   );
#
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# ── Almacenamiento de imágenes (Cloudinary) ───────────────────────────────────
# Crea una cuenta en https://cloudinary.com → Dashboard → "API Environment variable"
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz@mi-cloud

# ── Servidor ──────────────────────────────────────────────────────────────────
# Railway inyecta PORT automáticamente. En local usa 8000
PORT=8000
